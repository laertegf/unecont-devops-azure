# Copie para .env (que está no .gitignore) e troque os valores.
# Valores só para uso local.

POSTGRES_DB=realworld
POSTGRES_USER=realworld
POSTGRES_PASSWORD=troque-esta-senha

JWT_SECRET=troque-este-segredo-local

API_PORT=3000
LOG_LEVEL=info

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

